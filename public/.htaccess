<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow access to existing files and directories
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # If a specific directory is requested but missing a trailing slash, add it
  # (Helps with /product resolving to /product/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} !(.*)/$
  RewriteRule ^(.*)$ $1/ [L,R=301]

  # Rewrite all other requests to index.html (for SPA routing fallback)
  RewriteRule ^ /index.html [L]
</IfModule>
